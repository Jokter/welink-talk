{
  "welink_cli": "welink-cli",
  "welink_env": "pro",
  "auto_refresh_auth": true,
  "auth_refresh_interval_seconds": 1200,
  "auth_refresh_retry_seconds": 60,
  "auth_refresh_timeout_seconds": 60,
  "poll_interval_seconds": 5,
  "reply_max_chars": 3500,
  "ignore_existing_on_first_start": true,
  "state_file": "state.json",
  "bot_account": "p_xiaoluban",
  "private_chats": [
    {
      "account": "p_xiaoluban",
      "allowed_senders": ["w00789509"],
      "trigger_prefix": "/"
    }
  ],
  "reply": {
    "mode": "mcp",
    "config_path": "C:\\Users\\your-name\\.pi\\agent\\mcp.json",
    "server": "welink-msg",
    "tool": "send_welink_message",
    "timeout_seconds": 120
  },
  "pi": {
    "command": [
      "pi",
      "--model",
      "{model}",
      "--no-session",
      "--no-approve",
      "-p"
    ],
    "prompt_via_stdin": true,
    "working_directory": "C:\\work",
    "allowed_working_roots": [
      "C:\\work"
    ],
    "timeout_seconds": 900,
    "history_turns": 6,
    "default_model": "",
    "models": []
  }
}
