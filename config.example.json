{
  "welink_cli": "welink-cli",
  "welink_env": "pro",
  "auto_refresh_auth": true,
  "auth_refresh_interval_seconds": 1200,
  "auth_refresh_retry_seconds": 60,
  "auth_refresh_timeout_seconds": 60,
  "poll_interval_seconds": 5,
  "query_count": 20,
  "reply_max_chars": 3500,
  "ignore_existing_on_first_start": true,
  "state_file": "state.json",
  "private_chats": [
    {
      "account": "a0012345",
      "allowed_senders": ["a0012345"],
      "trigger_prefix": "/"
    }
  ],
  "group_chats": [
    {
      "group_id": "1234567891011",
      "allowed_senders": ["a0012345"],
      "trigger_prefix": "/"
    }
  ],
  "pi": {
    "command": [
      "pi",
      "--model",
      "{model}",
      "--no-session",
      "--no-approve",
      "-p"
    ],
    "prompt_via_stdin": true,
    "working_directory": "C:\\work",
    "timeout_seconds": 900,
    "history_turns": 6,
    "default_model": "",
    "models": []
  }
}
